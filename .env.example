# Public domain of the instance (add "VM-IP nextcloud.local" to /etc/hosts for local runs)
NC_DOMAIN=nextcloud.local
NC_PHONE_REGION=TN
TZ=Africa/Tunis

# Initial admin account (NEVER name it "admin")
NEXTCLOUD_ADMIN_USER=cloudadmin
NEXTCLOUD_ADMIN_PASSWORD=ChangeMe_Admin_2026

# Database (MariaDB)
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud
MYSQL_ROOT_PASSWORD=ChangeMe_Root_2026
MYSQL_PASSWORD=ChangeMe_DB_2026

# Redis (cache + file locking)
REDIS_HOST_PASSWORD=ChangeMe_Redis_2026

# Optional: fixed password for demo users created by scripts/iam.sh --demo
# (defaults to a strong random one, printed once when created)
# DEMO_USERS_PASSWORD=ChangeMe_Demo_2026

# Backup settings (used by scripts/backup.sh)
# BACKUP_DIR=./backups
# RETENTION_DAYS=30
